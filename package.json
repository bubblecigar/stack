{
  "name": "stack",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/kalam": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest && npm run test:server",
    "test:unit": "jest src/lib",
    "test:server": "node --test --test-concurrency=1 server/*.test.mjs",
    "prepare:collections": "node scripts/prepare-collection-assets.mjs",
    "evaluate:scan": "node scripts/evaluate-scan-quality.mjs",
    "export:web": "expo export --platform web --output-dir dist --clear",
    "build-internal": "npx eas-cli build --profile internal --platform ios",
    "deploy:ios": "npx eas-cli build --platform ios --profile production --auto-submit",
    "deploy:vultr": "bash scripts/deploy-vultr.sh",
    "authserver": "AUTH_HOST=0.0.0.0 node server/authserver.mjs",
    "apiserver": "API_HOST=0.0.0.0 node server/apiserver.mjs"
  },
  "private": true,
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0"
  }
}
